# LocalSkillHub Backend Environment Template
# Copy this file to .env for local development.
# For production (Railway/Vercel), set these values in hosting dashboard variables.

PORT=5000
NODE_ENV=development

# Frontend/CORS
# Local:
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Production example:
# CORS_ORIGIN=https://localskillhub.vercel.app
# FRONTEND_URL=https://localskillhub.vercel.app

# Database
MONGODB_URI=your_mongodb_connection_string

# Auth
JWT_SECRET=your_strong_jwt_secret

# Redis (optional)
# Leave empty unless you have a managed Redis URL in production.
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# Stripe
STRIPE_SECRET_KEY=sk_test_or_sk_live_key
# Single webhook secret (optional if using STRIPE_WEBHOOK_SECRETS)
STRIPE_WEBHOOK_SECRET=whsec_single_secret
# If using two webhook destinations (Platform + Connect), use comma-separated values:
STRIPE_WEBHOOK_SECRETS=whsec_platform,whsec_connect

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_upload_preset
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# reCAPTCHA
RECAPTCHA_SECRET_KEY=your_recaptcha_secret

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password_or_app_password

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
# Keep literal \n in this single-line value when using dashboard variables
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
